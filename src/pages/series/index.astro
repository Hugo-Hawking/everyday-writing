---
// 系列总览页：列出所有系列（书名/简介/状态/章节数），链到 /series/<系列id>/。
// ref: reference/plans/2026-10-03_phase2_系列小说板块/plan.md §3 步骤2（总览页 getCollection('series')）
// ref: reference/plans/2026-10-03_phase2_系列小说板块/code_structure.md §1/§2（新增页面职责）
// ref: node_modules/astro/dist/content/runtime.d.ts:19（getCollection 返回 { id, data, collection, ... }，无 slug）
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const series = await getCollection('series');
const posts = await getCollection('posts');
// 章节数：posts.series（= 系列集合条目 id）匹配计数
// ref: reference/plans/2026-10-03_phase2_系列小说板块/code_structure.md §3（按 data.series === seriesId 过滤）
const countOf = (seriesId) => posts.filter((p) => p.data.series === seriesId).length;
---
<Base title="系列">
  <h1>系列</h1>
  <ul>
    {
      series.map((s) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}series/${s.id}/`}>{s.data.title}</a>
          <span>（{s.data.status}）</span>
          <span>共 {countOf(s.id)} 章</span>
          {s.data.description && <p>{s.data.description}</p>}
        </li>
      ))
    }
  </ul>
</Base>
